#!/bin/sh

set -eu

key="${1:-}"
tmp_file="$(mktemp)"
cat > "$tmp_file"

case "$key" in
    w|W|Return|enter)
        wallpaper="$(sed -n '1p' "$tmp_file")"
        if [ -n "${wallpaper:-}" ] && [ -f "$wallpaper" ]; then
            "$HOME/.config/i3/scripts/apply-wallpaper.sh" "$wallpaper"
        fi
        ;;
esac

rm -f "$tmp_file"
